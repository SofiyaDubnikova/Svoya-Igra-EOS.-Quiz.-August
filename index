    { min: 50,  title: 'Хороший уровень',     note: 'Больше половины ответов верные. Немного практики — и топ будет вашим.' },
    { min: 0,   title: 'Есть куда расти',     note: 'Загляните в базу знаний компании и возвращайтесь: вторая попытка всегда лучше первой.' },
  ]);

  /** Подписи всплывающих уведомлений во время игры. */
  const TOASTS = Object.freeze({
    correct: 'Верно! +1',
    wrong:   'Неверно — правильный ответ подсвечен',
    timeout: 'Время вышло — правильный ответ подсвечен',
  });

  const QUESTION_BANK = Object.freeze([
    { text: 'Какой год считается годом основания компании EOS Group?',
      options: ['1974', '1983', '1991', '2002'], correctIndex: 0 },
    { text: 'Что означает аббревиатура CRM в корпоративных системах?',
      options: ['Customer Relationship Management', 'Corporate Resource Model', 'Central Risk Monitor', 'Client Rating Method'], correctIndex: 0 },
    { text: 'Какой документ фиксирует правила обработки персональных данных в организации?',
      options: ['Политика обработки ПДн', 'Штатное расписание', 'Учётная политика', 'Табель учёта'], correctIndex: 0 },
    { text: 'Что такое KPI?',
      options: ['Ключевой показатель эффективности', 'Категория интеллекта', 'Класс приоритета', 'Кодекс правил'], correctIndex: 0 },
    { text: 'Какая функция Excel суммирует значения по условию?',
      options: ['СУММЕСЛИ', 'ВПР', 'СЦЕПИТЬ', 'СЧЁТЗ'], correctIndex: 0 },
    { text: 'Что означает дедлайн в проектной работе?',
      options: ['Крайний срок', 'Первый этап', 'Бюджет', 'Список задач'], correctIndex: 0 },
    { text: 'Какой инструмент используют для визуализации сроков проекта?',
      options: ['Диаграмма Ганта', 'Круговая диаграмма', 'Гистограмма', 'Спарклайн'], correctIndex: 0 },
    { text: 'Что такое онбординг?',
      options: ['Адаптация нового сотрудника', 'Списание техники', 'Годовой отчёт', 'Инвентаризация'], correctIndex: 0 },
    { text: 'Сколько минут в трёх с половиной часах?',
      options: ['210', '180', '240', '195'], correctIndex: 0 },
    { text: 'Какой протокол защищает передачу данных в браузере?',
      options: ['HTTPS', 'FTP', 'SMTP', 'POP3'], correctIndex: 0 },
    { text: 'Что означает термин «эскалация» в поддержке клиентов?',
      options: ['Передача на более высокий уровень', 'Закрытие обращения', 'Отказ клиенту', 'Скидка'], correctIndex: 0 },
