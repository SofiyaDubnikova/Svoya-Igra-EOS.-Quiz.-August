  .option--correct .option__icon,
  .option--wrong .option__icon { transform: translateY(-50%) scale(1); }

  .result__grid { grid-template-columns: 1fr; justify-items: center; gap: 22px; text-align: center; }
  .result__grade { font-size: 19px; }

  .podium { gap: 8px; margin-top: 36px; }
  .podium__ava { width: 38px; height: 38px; font-size: 12px; }
  .podium__name { font-size: 10.5px; }
