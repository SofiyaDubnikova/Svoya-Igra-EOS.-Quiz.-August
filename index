<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Викторина EOS — сезон 2</title>

<!-- Шрифты: Unbounded (акцентный) + Montserrat (основной) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/unbounded/500.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/unbounded/700.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/unbounded/900.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/montserrat/400.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/montserrat/500.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/montserrat/600.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/montserrat/700.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/montserrat/800.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/montserrat/900.css">

<style>
/* ============================================================
   ВИКТОРИНА EOS · СЕЗОН 2 · DESIGN v3 · COPY v2
   ------------------------------------------------------------
   01. Дизайн-токены
   02. База, типографика, фон
   03. Фоновые орбы
   04. Шапка (hero)
   05. Каркас и экраны
   06. Карточки
   07. Стартовый экран
   08. Экран вопроса (таймер-кольцо, тост, сегменты)
   09. Экран результата (кольцо точности, оценка)
   10. Экран рейтинга (пьедестал + таблица)
   11. Конфетти
   12. Анимации
   13. Адаптивность
   14. Доступность
   ============================================================ */

/* ---------- 01. Дизайн-токены ---------- */
:root {
  --red-900: #6E0A11;
  --red-700: #A5121B;
  --red-600: #D0181F;
  --red-500: #E01B24;
  --red-400: #EE3B43;

  --gold:      #E7C69A;
  --gold-soft: #FFF8EF;

  --surface:   #F5F5F8;
  --card:      #FFFFFF;
  --ink:       #1A1A1E;
  --ink-soft:  #4A4A55;
  --ink-muted: #8A8A99;
  --line:      #EDEDF2;
  --red-soft:  #FFF3F4;

  --success:      #1E9E5A;
  --success-soft: #E9F8EF;

  --radius: 22px;

  --shadow:      0 10px 30px rgba(30, 12, 14, .07), 0 2px 6px rgba(30, 12, 14, .04);
  --shadow-lift: 0 22px 48px rgba(143, 15, 24, .16);
  --shadow-red:  0 14px 32px rgba(208, 26, 34, .28);

  --gradient-red:  linear-gradient(135deg, var(--red-700), var(--red-500) 55%, var(--red-400));
  --gradient-hero: radial-gradient(120% 150% at 8% 0%, #5E070D 0%, #A5121B 38%, #D8181F 74%, #EA2C33 100%);

  --font-body:    'Montserrat', system-ui, sans-serif;
  --font-display: 'Unbounded', 'Montserrat', sans-serif;

  --ease: cubic-bezier(.22, .61, .36, 1);
}

/* ---------- 02. База, типографика, фон ---------- */
*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--font-body);
  background: var(--surface);
  color: var(--ink);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Тонкая сетка на фоне верхней части страницы */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: 44px 44px;
  opacity: .35;
  -webkit-mask-image: linear-gradient(#000 0%, transparent 52%);
          mask-image: linear-gradient(#000 0%, transparent 52%);
}

button { font-family: inherit; cursor: pointer; border: none; background: none; }
::selection { background: rgba(224, 27, 36, .18); }

:focus-visible {
  outline: 3px solid rgba(224, 27, 36, .35);
  outline-offset: 2px;
  border-radius: 6px;
}

.caps {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

/* ---------- 03. Фоновые орбы ---------- */
.orb {
  position: fixed;
  z-index: 0;
  border-radius: 50%;
  filter: blur(80px);
  opacity: .45;
  pointer-events: none;
}
.orb--left {
  top: 26vh; left: -180px;
  width: 440px; height: 440px;
  background: #FFD9DC;
  animation: orb-drift-a 18s var(--ease) infinite;
}
.orb--right {
  right: -140px; bottom: -140px;
  width: 380px; height: 380px;
  background: #FFEFDC;
  animation: orb-drift-b 22s var(--ease) infinite;
}

/* ---------- 04. Шапка (hero) ---------- */
.hero {
  position: relative;
  padding: 52px 20px 78px;
  background: var(--gradient-hero);
  color: #fff;
  text-align: center;
  overflow: hidden;
}
.hero__ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, .13);
  background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, .09), transparent 62%);
}
.hero__ring--lg { right: -90px;  bottom: -170px; width: 380px; height: 380px; }
.hero__ring--sm { left: -120px;  top: -140px;    width: 300px; height: 300px; opacity: .7; }

.hero__wave {
  position: absolute;
  left: 50%; bottom: -2px;
  transform: translateX(-50%);
  width: 150%; height: 56px;
  background: var(--surface);
  border-radius: 50% 50% 0 0;
}

.hero__badge {
  display: inline-block;
  padding: 9px 22px;
  border-radius: 999px;
  background: rgba(255, 255, 255, .15);
  border: 1px solid rgba(255, 255, 255, .22);
  backdrop-filter: blur(6px);
}
.hero .caps { font-size: 10.5px; }

.hero__title {
  margin: 26px 0 0;
  font-family: var(--font-display);
  font-size: clamp(26px, 5vw, 46px);
  font-weight: 900;
  letter-spacing: .01em;
  line-height: 1.08;
  text-shadow: 0 14px 34px rgba(0, 0, 0, .22);
}
.hero__title-accent { color: var(--gold); }

.hero__tagline {
  margin: 16px 0 0;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .78;
}

/* Мини-статистика турнира */
.hero__chips {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}
.chip {
  padding: 10px 18px;
  border-radius: 999px;
  background: rgba(255, 255, 255, .12);
  border: 1px solid rgba(255, 255, 255, .2);
  backdrop-filter: blur(6px);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  transition: transform .3s var(--ease), background .3s var(--ease);
}
.chip:hover { transform: translateY(-3px); background: rgba(255, 255, 255, .2); }
.chip b { color: var(--gold); margin-right: 7px; font-size: 12.5px; }

/* ---------- 05. Каркас и экраны ---------- */
.page {
  position: relative;
  z-index: 2;
  max-width: 760px;
  margin: 0 auto;
  padding: 0 22px 96px;
}
.lift { margin-top: -34px; }
.stack { display: flex; flex-direction: column; gap: 16px; }

.screen { display: none; }
.screen.is-active {
  display: block;
  animation: rise .55s var(--ease) both;
}

/* ---------- 06. Карточки ---------- */
.card {
  padding: 36px;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.card--flush { padding: 0; overflow: hidden; }
.card--accent {
  border-left: 4px solid transparent;
  background-image: linear-gradient(var(--card), var(--card)), var(--gradient-red);
  background-origin: border-box;
  background-clip: padding-box, border-box;
}

.title {
  margin: 0 0 10px;
  font-size: 23px;
  font-weight: 900;
  letter-spacing: -.01em;
}
.subtitle {
  margin: 0 0 28px;
  font-size: 13.5px;
  font-weight: 500;
  line-height: 1.7;
  color: var(--ink-muted);
}

/* ---------- 07. Стартовый экран ---------- */
.rules { margin: 0 0 30px; padding: 0; list-style: none; counter-reset: step; }
.rules__item {
  display: flex;
  gap: 16px;
  align-items: baseline;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}
.rules__item:first-child { padding-top: 0; }
.rules__item:last-child  { border: none; padding-bottom: 0; }
.rules__label {
  min-width: 84px;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--red-600);
}
.rules__text { font-size: 13.5px; font-weight: 500; line-height: 1.6; color: var(--ink-soft); }
.rules__text kbd {
  display: inline-block;
  padding: 2px 7px;
  border-radius: 6px;
  background: var(--surface);
  border: 1px solid var(--line);
  font-family: inherit;
  font-size: 11px;
  font-weight: 700;
  color: var(--ink-soft);
}

.field {
  width: 100%;
  padding: 17px 22px;
  font: 500 14.5px var(--font-body);
  color: var(--ink);
  background: #FAFAFC;
  border: 1.5px solid var(--line);
  border-radius: 999px;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, .03);
  outline: none;
  transition: border-color .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease);
}
.field:focus {
  background: #fff;
  border-color: var(--red-400);
  box-shadow: 0 0 0 4px rgba(224, 27, 36, .10);
}
.field--invalid {
  border-color: var(--red-500);
  box-shadow: 0 0 0 4px rgba(224, 27, 36, .10);
  animation: shake .5s var(--ease);
}
.field-error {
  display: none;
  margin: 10px 4px 0;
  font-size: 12px;
  font-weight: 600;
  color: var(--red-500);
}
.field-error.is-visible { display: block; }

.actions { display: flex; flex-direction: column; gap: 14px; margin-top: 22px; }
.actions--flush { margin-top: 0; }

.btn {
  position: relative;
  overflow: hidden;
  width: 100%;
  padding: 18px;
  border-radius: 999px;
  background: var(--gradient-red);
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  box-shadow: var(--shadow-red);
  transition: transform .35s var(--ease), box-shadow .35s var(--ease), background .35s var(--ease);
}
/* Блик, пробегающий по кнопке */
.btn::after {
  content: '';
  position: absolute;
  top: 0; left: -80%;
  width: 50%; height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .35), transparent);
  transform: skewX(-20deg);
  transition: left .6s var(--ease);
}
.btn:hover { transform: translateY(-3px); box-shadow: 0 20px 40px rgba(208, 26, 34, .34); }
.btn:hover::after { left: 130%; }
.btn:active { transform: translateY(-1px) scale(.985); }

.btn--ghost {
  background: #fff;
  color: var(--red-600);
  border: 1.5px solid #FFD3D6;
  box-shadow: var(--shadow);
}
.btn--ghost::after { background: linear-gradient(100deg, transparent, rgba(224, 27, 36, .08), transparent); }
.btn--ghost:hover { background: var(--red-soft); box-shadow: 0 14px 30px rgba(208, 26, 34, .13); }

/* ---------- 08. Экран вопроса ---------- */
.quiz-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 26px;
  background: var(--gradient-hero);
  color: #fff;
}
.quiz-bar__counter { opacity: .85; }

/* Таймер-кольцо */
.timer {
  position: relative;
  display: grid;
  place-items: center;
  width: 80px; height: 80px;
  border-radius: 50%;
  background: rgba(255, 255, 255, .12);
  border: 1px solid rgba(255, 255, 255, .2);
  transition: background .3s var(--ease), box-shadow .3s var(--ease);
}
.timer__ring { position: absolute; inset: 4px; transform: rotate(-90deg); }
.timer__ring circle { fill: none; stroke-width: 4; stroke-linecap: round; }
.timer__ring-bg   { stroke: rgba(255, 255, 255, .22); }
.timer__ring-fill { stroke: #fff; }
.timer__inner { position: relative; text-align: center; }
.timer__value { font-family: var(--font-display); font-size: 21px; font-weight: 700; line-height: 1; }
.timer__label { margin-top: 3px; font-size: 8px; font-weight: 700; letter-spacing: .16em; opacity: .75; text-transform: uppercase; }

.timer--warn {
  background: #fff;
  box-shadow: 0 10px 26px rgba(224, 27, 36, .35);
  animation: pulse 1s infinite;
}
.timer--warn .timer__ring-bg   { stroke: #F4CDD0; }
.timer--warn .timer__ring-fill { stroke: var(--red-500); }
.timer--warn .timer__value     { color: var(--red-600); }
.timer--warn .timer__label     { color: var(--red-600); opacity: .8; }

.quiz-body { position: relative; padding: 34px 30px 36px; }
.question {
  margin: 0;
  font-size: clamp(18px, 3.4vw, 23px);
  font-weight: 800;
  line-height: 1.45;
}

.options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 30px;
}
.option {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-height: 118px;
  padding: 22px 20px;
  text-align: left;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  color: var(--ink);
  background: #fff;
  border: 1.5px solid var(--line);
  border-radius: 18px;
  box-shadow: var(--shadow);
  transition: transform .32s var(--ease), background .32s var(--ease),
              border-color .32s var(--ease), box-shadow .32s var(--ease), opacity .32s var(--ease);
}
.option:hover:not(:disabled) {
  transform: translateY(-5px);
  background: var(--red-soft);
  border-color: #FFCACE;
  box-shadow: var(--shadow-lift);
}
.option:active:not(:disabled) { transform: translateY(-2px) scale(.98); }
.option:disabled { cursor: default; }

.option__key {
  flex: none;
  display: grid;
  place-items: center;
  width: 28px; height: 28px;
  border-radius: 50%;
  background: var(--red-soft);
  color: var(--red-600);
  font-size: 12px;
  font-weight: 900;
  transition: background .3s var(--ease), color .3s var(--ease);
}
.option__text { padding-right: 30px; }

/* Иконка результата (✓ / ✕) */
.option__icon {
  position: absolute;
  top: 16px; right: 16px;
  display: grid;
  place-items: center;
  width: 26px; height: 26px;
  border-radius: 50%;
  font-size: 13px;
  font-weight: 900;
  opacity: 0;
  transform: scale(.4);
  transition: opacity .35s var(--ease), transform .35s var(--ease);
}
.option--correct .option__icon { opacity: 1; transform: scale(1); background: var(--success); color: #fff; }
.option--correct .option__icon::before { content: '✓'; }
.option--wrong .option__icon   { opacity: 1; transform: scale(1); background: var(--red-500); color: #fff; }
.option--wrong .option__icon::before { content: '✕'; }

.option--selected { background: var(--red-soft); border-color: var(--red-400); box-shadow: var(--shadow-lift); }
.option--selected .option__key { background: var(--red-500); color: #fff; }

.option--correct { background: var(--success-soft); border-color: var(--success); animation: pop .45s var(--ease); }
.option--correct .option__key { background: var(--success); color: #fff; }
.option--wrong { background: var(--red-soft); border-color: var(--red-500); animation: shake .5s var(--ease); }
.option--wrong .option__key { background: var(--red-500); color: #fff; }
.option--dim { opacity: .4; }

.quiz-hint {
  margin: 22px 0 0;
  text-align: center;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .04em;
  color: var(--ink-muted);
}

/* Всплывающий тост обратной связи */
.toast {
  position: absolute;
  top: 12px; left: 50%;
  transform: translate(-50%, -14px);
  z-index: 5;
  padding: 10px 22px;
  border-radius: 999px;
  white-space: nowrap;
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .06em;
  opacity: 0;
  pointer-events: none;
  transition: opacity .35s var(--ease), transform .35s var(--ease);
}
.toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
.toast--ok   { background: var(--success);  box-shadow: 0 10px 24px rgba(30, 158, 90, .35); }
.toast--fail { background: var(--red-500);  box-shadow: 0 10px 24px rgba(224, 27, 36, .35); }
.toast--warn { background: var(--ink);      box-shadow: 0 10px 24px rgba(0, 0, 0, .25); }

/* Сегментированный прогресс: зелёный — верно, красный — ошибка */
.progress { display: flex; gap: 6px; margin-top: 24px; }
.progress__seg {
  flex: 1;
  height: 6px;
  border-radius: 99px;
  background: #DFDFE7;
  transition: background .4s var(--ease);
}
.progress__seg--ok      { background: var(--success); }
.progress__seg--fail    { background: var(--red-500); }
.progress__seg--current {
  background: linear-gradient(90deg, var(--red-400), var(--red-600));
  animation: seg-pulse 1.6s infinite;
}

/* ---------- 09. Экран результата ---------- */
.result {
  padding: 42px 34px;
  color: #fff;
  background: var(--gradient-red);
  border-radius: var(--radius);
  box-shadow: var(--shadow-red);
}
.result__caption { text-align: center; opacity: .8; }

.result__grid {
  display: grid;
  grid-template-columns: 150px 1fr;
  gap: 30px;
  align-items: center;
  margin-top: 28px;
  text-align: left;
}

/* Кольцо точности */
.acc { position: relative; width: 150px; height: 150px; }
.acc svg { position: absolute; inset: 0; transform: rotate(-90deg); }
.acc circle { fill: none; stroke-width: 9; stroke-linecap: round; }
.acc__bg   { stroke: rgba(255, 255, 255, .18); }
.acc__fill { stroke: #fff; }
.acc__center {
  position: absolute;
  inset: 0;
  display: grid;
  place-content: center;
  text-align: center;
}
.acc__num { font-family: var(--font-display); font-size: 30px; font-weight: 900; }
.acc__label { margin-top: 5px; font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; opacity: .8; }

.result__grade {
  font-family: var(--font-display);
  font-size: clamp(20px, 3.6vw, 27px);
  font-weight: 700;
  line-height: 1.25;
}
.result__note { margin-top: 10px; font-size: 13px; font-weight: 500; line-height: 1.65; opacity: .88; }
.result__name { margin-top: 14px; color: var(--gold); font-size: 14px; font-weight: 700; letter-spacing: .02em; }

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 28px;
}
.stat {
  padding: 18px 8px;
  border-radius: 16px;
  background: rgba(255, 255, 255, .13);
  border: 1px solid rgba(255, 255, 255, .18);
  text-align: center;
}
.stat__value { font-family: var(--font-display); font-size: 20px; font-weight: 700; }
.stat__sep { opacity: .55; font-size: 15px; }
.stat__label {
  margin-top: 6px;
  font-size: 8.5px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  opacity: .82;
}

/* ---------- 10. Экран рейтинга: пьедестал ---------- */
.podium {
  display: flex;
  gap: 14px;
  align-items: flex-end;
  margin-top: 42px;
}
.podium__col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.podium__card {
  position: relative;
  width: 100%;
  padding: 20px 10px 16px;
  text-align: center;
  background: #fff;
  border: 1.5px solid var(--line);
  border-radius: 18px;
  box-shadow: var(--shadow);
  animation: rise .6s var(--ease) both;
  transition: transform .35s var(--ease), box-shadow .35s var(--ease);
}
.podium__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
.podium__col--1 .podium__card {
  border-color: #EAD9BC;
  background: linear-gradient(#FFFDF8, #fff);
  animation-delay: .12s;
}
.podium__col--3 .podium__card { animation-delay: .24s; }

.podium__medal {
  position: absolute;
  top: -13px; left: 50%;
  transform: translateX(-50%);
  width: 26px; height: 26px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 11px;
  font-weight: 900;
  color: #5C430F;
  background: linear-gradient(135deg, #FFE9B8, #E8BC66);
  box-shadow: 0 4px 10px rgba(190, 150, 60, .4);
}
.podium__medal--2 { background: linear-gradient(135deg, #F2F3F6, #C3C7D1); color: #555A66; box-shadow: 0 4px 10px rgba(140, 145, 160, .35); }
.podium__medal--3 { background: linear-gradient(135deg, #F3D3B3, #D89A62); color: #6B4318; box-shadow: 0 4px 10px rgba(190, 130, 80, .35); }

.podium__ava {
  width: 46px; height: 46px;
  margin: 8px auto 9px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 14px;
  font-weight: 900;
  color: #fff;
  background: var(--gradient-red);
}
.podium__col--2 .podium__ava { background: linear-gradient(135deg, #9BA0AE, #C9CDD6); }
.podium__col--3 .podium__ava { background: linear-gradient(135deg, #C98A57, #E6B98C); }

.podium__name { font-size: 12px; font-weight: 800; line-height: 1.35; overflow-wrap: anywhere; }
.podium__meta { margin-top: 6px; font-size: 10.5px; font-weight: 600; color: var(--ink-muted); }
.podium__meta b { color: var(--ink); font-size: 12px; }
.podium__tag {
  display: inline-block;
  margin-top: 8px;
  padding: 3px 9px;
  border-radius: 999px;
  background: var(--red-500);
  color: #fff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.podium__bar { width: 78%; margin-top: 10px; border-radius: 10px 10px 0 0; }
.podium__col--1 .podium__bar { height: 104px; background: var(--gradient-red); opacity: .92; }
.podium__col--2 .podium__bar { height: 70px;  background: linear-gradient(180deg, #C9CDD6, #EDEFF3); }
.podium__col--3 .podium__bar { height: 48px;  background: linear-gradient(180deg, #E0A874, #F3DCC8); }

/* ---------- 10б. Экран рейтинга: таблица ---------- */
.board { margin-top: 30px; }
.board__row {
  display: grid;
  grid-template-columns: 46px 1fr 64px 64px;
  gap: 12px;
  align-items: center;
  padding: 16px 14px;
  border-bottom: 1px solid var(--line);
  border-radius: 12px;
  font-size: 13.5px;
  font-weight: 600;
}
.board__row--head {
  padding: 12px 14px;
  border-bottom: 1.5px solid var(--line);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--red-600);
}
.board__place { font-weight: 900; color: var(--ink-muted); text-align: center; }
.board__num   { font-weight: 700; color: var(--ink-soft); text-align: center; }
.board__row--mine { background: var(--red-soft); box-shadow: inset 3px 0 0 var(--red-500); }
.board__tag {
  display: inline-block;
  margin-left: 8px;
  padding: 3px 9px;
  border-radius: 999px;
  background: var(--red-500);
  color: #fff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.board__gap { display: flex; justify-content: center; gap: 7px; padding: 12px 0; }
.board__gap span { width: 5px; height: 5px; border-radius: 50%; background: #C9C9D2; }

/* ---------- 11. Конфетти ---------- */
.confetti {
  position: fixed;
  top: -20px;
  z-index: 99;
  width: 9px; height: 9px;
  pointer-events: none;
  animation: confetti-fall 3s linear forwards;
}

/* ---------- 12. Анимации ---------- */
@keyframes rise { from { opacity: 0; transform: translateY(22px); } }
@keyframes pulse { 50% { transform: scale(1.06); } }
@keyframes seg-pulse { 50% { opacity: .5; } }
@keyframes orb-drift-a { 50% { transform: translate(60px, -40px); } }
@keyframes orb-drift-b { 50% { transform: translate(-50px, 40px); } }
@keyframes confetti-fall { to { transform: translateY(105vh) rotate(680deg); opacity: 0; } }
@keyframes shake {
  20% { transform: translateX(-7px); }
  40% { transform: translateX(6px); }
  60% { transform: translateX(-4px); }
  80% { transform: translateX(3px); }
}
@keyframes pop {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.03); }
  100% { transform: scale(1); }
}

/* ---------- 13. Адаптивность ---------- */
@media (max-width: 560px) {
  .hero { padding: 42px 20px 64px; }
  .card { padding: 26px; }
  .quiz-body { padding: 26px 22px 28px; }
