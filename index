      accFill: $('#acc-fill'),
      accNum:  $('#acc-num'),
      grade:   $('#res-grade'),
      note:    $('#res-note'),
      name:    $('#res-name'),
      score:   $('#res-score'),
      total:   $('#res-total'),
      time:    $('#stat-time'),
      streak:  $('#stat-streak'),
      toBoard: $('#btn-to-board'),
      restart: $('#btn-restart'),
    },
    board: {
      podium: $('#podium'),
      rows:   $('#board-rows'),
      back:   $('#btn-back'),
    },
  };

  /* ============================================================
     04. УТИЛИТЫ
     ============================================================ */

  function shuffle(list) {
    const copy = [...list];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  const formatTime = (totalSeconds) =>
    `${Math.floor(totalSeconds / 60)}:${String(totalSeconds % 60).padStart(2, '0')}`;

  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]
  ));

  const getInitials = (name) =>
    name.split(/\s+/).map((word) => word[0]).join('').slice(0, 2).toUpperCase();

  function capitalizeName(raw) {
    return raw
      .split(/\s+/)
      .slice(0, 2)
      .map((word) => word[0].toUpperCase() + word.slice(1).toLowerCase())
      .join(' ');
  }

  /** Плавный счётчик с произвольным форматом вывода. */
  function animateNumber(element, target, { duration = 700, format = (v) => v } = {}) {
    const startedAt = performance.now();
    const tick = (now) => {
      const progress = Math.min((now - startedAt) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      element.textContent = format(Math.round(target * eased));
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  /* ============================================================
     05. НАВИГАЦИЯ МЕЖДУ ЭКРАНАМИ
     ============================================================ */

  function showScreen(name) {
    dom.screens.forEach((screen) =>
      screen.classList.toggle('is-active', screen.dataset.screen === name));
    window.scrollTo(0, 0);
  }

  const isScreenActive = (name) =>
    document.querySelector(`[data-screen="${name}"]`)?.classList.contains('is-active') ?? false;

  /* ============================================================
     06. СТАРТ ИГРЫ
     ============================================================ */

  function startGame() {
    const rawName = dom.start.name.value.trim();

    if (!CONFIG.namePattern.test(rawName)) {
      setNameError(true);
      dom.start.name.focus();
      return;
    }

    state.player       = capitalizeName(rawName);
    state.questions    = buildQuiz();
    state.index        = 0;
    state.score        = 0;
    state.spentSeconds = 0;
    state.history      = [];
    state.streak       = 0;
    state.bestStreak   = 0;
    state.answers      = [];

    dom.quiz.total.textContent = CONFIG.questionsPerGame;
    buildProgressSegments();
    showScreen('quiz');
    renderQuestion();
  }

  function buildQuiz() {
    return shuffle(QUESTION_BANK)
      .slice(0, CONFIG.questionsPerGame)
      .map((item) => {
        const correctText = item.options[item.correctIndex];
        const options     = shuffle(item.options);
        return { text: item.text, options, correctIndex: options.indexOf(correctText) };
      });
  }

  function setNameError(visible) {
    dom.start.name.classList.remove('field--invalid');
    if (visible) {
      void dom.start.name.offsetWidth; // перезапуск анимации shake
      dom.start.name.classList.add('field--invalid');
    }
    dom.start.nameError.classList.toggle('is-visible', visible);
  }

  /* ============================================================
     07. ОТРИСОВКА ВОПРОСА
     ============================================================ */

  function renderQuestion() {
    const question = state.questions[state.index];

    state.locked   = false;
    state.selected = null;

    dom.quiz.number.textContent   = state.index + 1;
    dom.quiz.question.textContent = question.text;
    dom.quiz.options.innerHTML    = question.options
      .map((option, idx) => `
        <button type="button" class="option" data-index="${idx}">
          <span class="option__key">${CONFIG.answerLetters[idx]}</span>
          <span class="option__text">${escapeHtml(option)}</span>
          <span class="option__icon" aria-hidden="true"></span>
        </button>`)
      .join('');

    paintProgress();
    startTimer();
  }

  /* ---------- Сегментированный прогресс ---------- */

  function buildProgressSegments() {
    dom.quiz.progress.innerHTML = state.questions
      .map(() => '<span class="progress__seg"></span>')
      .join('');
  }

  function paintProgress() {
    $$('.progress__seg', dom.quiz.progress).forEach((segment, idx) => {
      segment.className = 'progress__seg';
      if (idx < state.history.length) {
        segment.classList.add(state.history[idx] ? 'progress__seg--ok' : 'progress__seg--fail');
      } else if (idx === state.index) {
        segment.classList.add('progress__seg--current');
      }
    });
  }

  /* ---------- Тост обратной связи ---------- */

  function showToast(kind, text) {
    const toast = dom.quiz.toast;
    clearTimeout(state.toastId);

    toast.className = `toast toast--${kind}`;
    toast.textContent = text;
    void toast.offsetWidth;
    toast.classList.add('is-visible');

    state.toastId = setTimeout(() => toast.classList.remove('is-visible'), 1100);
  }

  /* ============================================================
     08. ТАЙМЕР-КОЛЬЦО
     ============================================================ */

  function startTimer() {
    stopTimer();

    state.timeLeft = CONFIG.secondsPerQuestion;
    dom.quiz.timer.classList.remove('timer--warn');
    updateTimerUi();
    restartTimerRing();

    state.timerId = setInterval(() => {
      state.timeLeft     -= 1;
      state.spentSeconds += 1;
      updateTimerUi();

      if (state.timeLeft <= CONFIG.warningThreshold) dom.quiz.timer.classList.add('timer--warn');
      if (state.timeLeft <= 0) confirmAnswer(TIMEOUT);
    }, 1000);
  }

  function stopTimer() {
    if (state.timerId !== null) {
      clearInterval(state.timerId);
      state.timerId = null;
    }
    freezeTimerRing();
  }

  const updateTimerUi = () => { dom.quiz.timerValue.textContent = state.timeLeft; };

  /** Кольцо «стекает» с 0 до полной длины окружности за отведённое время. */
  function restartTimerRing() {
    const ring = dom.quiz.timerRing;
    ring.style.transition = 'none';
    ring.style.strokeDashoffset = '0';
    void ring.getBoundingClientRect();
    ring.style.transition = `stroke-dashoffset ${CONFIG.secondsPerQuestion}s linear`;
    ring.style.strokeDashoffset = String(TIMER_C);
  }

  function freezeTimerRing() {
    const ring = dom.quiz.timerRing;
    ring.style.strokeDashoffset = getComputedStyle(ring).strokeDashoffset;
    ring.style.transition = 'none';
  }

  /* ============================================================
     09. ОБРАБОТКА ОТВЕТА
     ============================================================ */

  function handleOptionClick(index) {
    if (state.locked) return;

    if (state.selected === index) {
      confirmAnswer(index);
      return;
    }

    state.selected = index;
    $$('.option', dom.quiz.options).forEach((button) =>
      button.classList.toggle('option--selected', Number(button.dataset.index) === index));
  }

  function confirmAnswer(chosenIndex) {
    if (state.locked) return;

    state.locked = true;
    stopTimer();

    const question  = state.questions[state.index];
    const isCorrect = chosenIndex === question.correctIndex;
    const timeSpent = CONFIG.secondsPerQuestion - state.timeLeft;

    // Сохраняем детали ответа для Google Sheets
    state.answers.push({
      questionNumber: state.index + 1,
      questionText: question.text,
      userAnswer: chosenIndex === TIMEOUT ? 'Время вышло' : question.options[chosenIndex],
      correctAnswer: question.options[question.correctIndex],
      isCorrect: isCorrect,
      timeSpent: timeSpent,
    });

    $$('.option', dom.quiz.options).forEach((button) => {
      const idx = Number(button.dataset.index);
      button.disabled = true;
      button.classList.remove('option--selected');

      if (idx === question.correctIndex) button.classList.add('option--correct');
      else if (idx === chosenIndex)      button.classList.add('option--wrong');
      else                               button.classList.add('option--dim');
    });

    if (isCorrect) {
      state.score += 1;
      state.streak += 1;
      state.bestStreak = Math.max(state.bestStreak, state.streak);
    } else {
      state.streak = 0;
    }
    state.history.push(isCorrect);
    paintProgress();

    if (chosenIndex === TIMEOUT) showToast('warn', TOASTS.timeout);
    else if (isCorrect)          showToast('ok',   TOASTS.correct);
    else                         showToast('fail', TOASTS.wrong);

    setTimeout(nextQuestion, CONFIG.answerRevealDelay);
  }

  function nextQuestion() {
    state.index += 1;
    if (state.index < state.questions.length) renderQuestion();
    else finishGame();
  }

  /* ============================================================
     10. ФИНАЛ ИГРЫ
     ============================================================ */

  function finishGame() {
    stopTimer();

    const total    = state.questions.length;
    const accuracy = Math.round((state.score / total) * 100);
    const grade    = GRADES.find((item) => accuracy >= item.min);

    state.lastResultId = saveResult();

    // Отправляем данные в Google Sheets
    sendToGoogleSheets();

    dom.result.grade.textContent  = grade.title;
    dom.result.note.textContent   = grade.note;
    dom.result.name.textContent   = state.player;
    dom.result.time.textContent   = formatTime(state.spentSeconds);
    dom.result.streak.textContent = state.bestStreak;

    animateNumber(dom.result.score, state.score);
    animateNumber(dom.result.accNum, accuracy, { duration: 1100, format: (v) => `${v}%` });
    animateAccuracyRing(accuracy);

    showScreen('result');
    if (accuracy >= CONFIG.passThreshold) launchConfetti();
  }

  /** Плавное заполнение кольца точности. */
  function animateAccuracyRing(accuracy) {
    const ring = dom.result.accFill;
    ring.style.transition = 'none';
    ring.style.strokeDashoffset = String(ACC_C);
    void ring.getBoundingClientRect();
    ring.style.transition = 'stroke-dashoffset 1.2s var(--ease)';
    ring.style.strokeDashoffset = String(ACC_C * (1 - accuracy / 100));
  }

  /* ============================================================
     11. ОТПРАВКА ДАННЫХ В GOOGLE SHEETS
     ============================================================ */

  function sendToGoogleSheets() {
    const resultData = {
      id: state.lastResultId,
      name: state.player,
      score: state.score,
      totalQuestions: state.questions.length,
      accuracy: Math.round((state.score / state.questions.length) * 100),
      timeSeconds: state.spentSeconds,
      bestStreak: state.bestStreak,
      answers: state.answers,
    };

    fetch(GOOGLE_SHEETS_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(resultData),
    })
    .then(() => {
      console.log('✅ Данные отправлены в Google Sheets');
    })
    .catch((error) => {
      console.error('❌ Ошибка отправки в Google Sheets:', error);
    });
  }

  /* ============================================================
     12. ЗАГРУЗКА РЕЙТИНГА ИЗ GOOGLE SHEETS
     ============================================================ */

  async function loadLeaderboardFromSheets() {
    try {
      const response = await fetch(GOOGLE_SHEETS_URL);
      const data = await response.json();
      return Array.isArray(data) ? data : [];
    } catch (error) {
      console.error('Ошибка загрузки рейтинга:', error);
      return [];
    }
  }

  /* ============================================================
     13. РЕЙТИНГ И ХРАНЕНИЕ
     ============================================================ */

  function readSavedResults() {
    try {
      return JSON.parse(localStorage.getItem(CONFIG.storageKey)) ?? [];
    } catch {
      return [];
    }
  }

  function saveResult() {
    const entry = {
      id: Date.now(),
      name: state.player,
      score: state.score,
      seconds: state.spentSeconds,
    };
    try {
      localStorage.setItem(CONFIG.storageKey, JSON.stringify([...readSavedResults(), entry]));
    } catch {
      /* приватный режим — результат не сохраняется */
    }
    return entry.id;
  }

  async function renderLeaderboard(highlightId = null) {
    // Показываем экран рейтинга сразу
    showScreen('leaderboard');
    
    // Загружаем результаты из Google Sheets
    const sheetResults = await loadLeaderboardFromSheets();
    
    // Если есть данные из Sheets, используем их
    let all = sheetResults.length > 0 ? sheetResults : [...DEMO_RESULTS, ...readSavedResults()];
    
    // Сортируем по очкам и времени
    all = all.sort((a, b) => b.score - a.score || a.seconds - b.seconds);
    
    const isMine = (entry) => entry.name === state.player;
    
    // Пьедестал: топ-3
    dom.board.podium.innerHTML = buildPodiumHtml(all.slice(0, CONFIG.podiumSize), isMine);
    
    // Таблица: места 4–10
    const rest = all.slice(CONFIG.podiumSize, CONFIG.boardSize);
    
    let html = rest
      .map((entry, offset) => boardRowHtml(entry, CONFIG.podiumSize + offset, isMine(entry)))
      .join('');
    
    dom.board.rows.innerHTML = html;
  }

  /** Пьедестал рисуется в порядке: серебро · золото · бронза. */
  function buildPodiumHtml(topThree, isMine) {
    const layout = [1, 0, 2]; // индексы мест для визуального порядка
    return layout
      .filter((rank) => topThree[rank])
      .map((rank) => podiumCardHtml(topThree[rank], rank, isMine(topThree[rank])))
      .join('');
  }

  function podiumCardHtml(entry, rank, mine) {
    const place = rank + 1;
    return `
      <div class="podium__col podium__col--${place}">
        <div class="podium__card">
          <div class="podium__medal ${place > 1 ? `podium__medal--${place}` : ''}">${place}</div>
          <div class="podium__ava">${escapeHtml(getInitials(entry.name))}</div>
          <div class="podium__name">${escapeHtml(entry.name)}</div>
          <div class="podium__meta"><b>${entry.score}</b> верно · ${formatTime(entry.seconds)}</div>
          ${mine ? '<div class="podium__tag">вы</div>' : ''}
        </div>
        <div class="podium__bar"></div>
      </div>`;
  }

  function boardRowHtml(entry, place, mine) {
    const rowClass = `board__row${mine ? ' board__row--mine' : ''}`;
    const tag      = mine ? '<span class="board__tag">вы</span>' : '';
    return `
      <div class="${rowClass}">
        <div class="board__place">${place + 1}</div>
        <div class="board__name">${escapeHtml(entry.name)}${tag}</div>
        <div class="board__num">${entry.score}</div>
        <div class="board__num">${formatTime(entry.seconds)}</div>
      </div>`;
  }

  /* ============================================================
     14. ЭФФЕКТЫ
     ============================================================ */

  function launchConfetti(count = 90) {
    const colors   = ['#E01B24', '#E7C69A', '#FFFFFF', '#A5121B'];
    const fragment = document.createDocumentFragment();

    Array.from({ length: count }, (_, i) => {
      const piece = document.createElement('div');
      piece.className = 'confetti';
      piece.style.left           = `${Math.random() * 100}vw`;
      piece.style.background     = colors[i % colors.length];
      piece.style.animationDelay = `${(Math.random() * 1.2).toFixed(2)}s`;
      if (i % 3 === 0) piece.style.borderRadius = '50%';
      fragment.appendChild(piece);
    });

    document.body.appendChild(fragment);
    setTimeout(() => $$('.confetti').forEach((piece) => piece.remove()), 4600);
  }

  /* ============================================================
     15. СОБЫТИЯ
     ============================================================ */

  function bindEvents() {
    dom.start.start.addEventListener('click', startGame);
    dom.start.peek.addEventListener('click', () => renderLeaderboard());
    dom.start.name.addEventListener('input', () => setNameError(false));
    dom.start.name.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') startGame();
    });

    dom.quiz.options.addEventListener('click', (event) => {
      const button = event.target.closest('.option');
      if (button) handleOptionClick(Number(button.dataset.index));
    });

    dom.result.toBoard.addEventListener('click', () => renderLeaderboard(state.lastResultId));
    dom.result.restart.addEventListener('click', () => showScreen('start'));
    dom.board.back.addEventListener('click', () => showScreen('start'));

    document.addEventListener('keydown', (event) => {
      if (!isScreenActive('quiz') || state.locked) return;

      const digit = Number(event.key);
      if (Number.isInteger(digit) && digit >= 1 && digit <= CONFIG.answerLetters.length) {
        handleOptionClick(digit - 1);
      } else if (event.key === 'Enter' && state.selected !== null) {
        confirmAnswer(state.selected);
      }
    });
  }

  /* ============================================================
     16. ИНИЦИАЛИЗАЦИЯ
     ============================================================ */

  function init() {
    dom.result.total.textContent = `/${CONFIG.questionsPerGame}`;

    // Подготовка SVG-колец
    dom.quiz.timerRing.style.strokeDasharray  = String(TIMER_C);
    dom.quiz.timerRing.style.strokeDashoffset = '0';
    dom.result.accFill.style.strokeDasharray  = String(ACC_C);
    dom.result.accFill.style.strokeDashoffset = String(ACC_C);

    bindEvents();
  }

  init();
})();
</script>
