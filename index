  /** Текстовые оценки результата (по % точности, сверху вниз). */
  const GRADES = Object.freeze([
    { min: 100, title: 'Безупречно!',         note: '8 из 8 — ни одной ошибки. Вы главный претендент на пьедестал сезона.' },
